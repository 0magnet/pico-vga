# Raspberry Pi Pico udev rules
# Allows picotool and serial access without sudo

# Pico in BOOTSEL mode
SUBSYSTEM=="usb", ATTR{idVendor}=="2e8a", ATTR{idProduct}=="0003", MODE="0666", GROUP="plugdev"

# Pico running application (CDC serial)
SUBSYSTEM=="usb", ATTR{idVendor}=="2e8a", ATTR{idProduct}=="000a", MODE="0666", GROUP="plugdev"

# Pico SDK debug probe
SUBSYSTEM=="usb", ATTR{idVendor}=="2e8a", ATTR{idProduct}=="0004", MODE="0666", GROUP="plugdev"

# Generic rule for all Raspberry Pi USB devices
SUBSYSTEM=="usb", ATTR{idVendor}=="2e8a", MODE="0666", GROUP="plugdev"
